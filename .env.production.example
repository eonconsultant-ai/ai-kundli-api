# Reference values for the production environment. Never commit a real .env.
# Cloud Run takes these as service environment variables and mounts the Gemini
# key from Secret Manager; a VM reads them from backend/.env.
ENVIRONMENT=production
EPHE_PATH=ephe

# Mobile apps do not send an Origin header, so this only matters for browsers.
CORS_ORIGINS=https://yourdomain.example

# AI. Use a paid Gemini project before public launch: free-tier content may be
# used to improve Google's products. On Cloud Run this is mounted from the
# `gemini-api-key` secret, so it stays out of the service definition.
GEMINI_API_KEY=
# Optional extra keys, comma separated. The server tries every key for the
# primary model, then every key for the fallback model; a 429 parks that
# (key, model) pair for 60s. Keys inside one Google Cloud project share the same
# free-tier quota, so extra keys only add throughput across separate projects.
# Do not use extra projects to exceed the free quota; that breaks Google's terms.
GEMINI_API_KEYS=
# Primary and fallback models, tried in order. Confirm the IDs in AI Studio.
# Do not pin a model with a published shutdown date (gemini-2.5-flash retires
# on 2026-11-17 and is no longer in the default chain).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Google Search grounding for general Vedic context and free remedies. If the
# model or tier rejects the tool, the server retries that model without it.
GEMINI_ENABLE_SEARCH=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=45
AI_CACHE_TTL_SECONDS=43200
AI_CACHE_MAX_ENTRIES=500

# AI cost controls. Free users get 5 messages/day; Plus gets 50. The global
# budget caps total provider calls per IST day across all installs.
AI_FREE_DAILY_MESSAGES=5
AI_PLUS_DAILY_MESSAGES=50
AI_GLOBAL_DAILY_BUDGET=2000
AI_HISTORY_TURNS=8
AI_MAX_OUTPUT_TOKENS=400
# Search grounding is billed per request and costs far more than the tokens, so
# free installs ground only their first message of the day. Plus is uncapped
# (its 50-message quota is the ceiling). Set 0 to give free chat no grounding.
AI_FREE_GROUNDED_MESSAGES=1

# Optional second text provider for chat only, tried after every Gemini
# model/key pair fails. OpenAI-compatible endpoint; leave the key empty to
# disable. It has no search grounding, and readings/voice stay Gemini-only.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30

# Where quotas, entitlements and reports are kept. Cloud Run has no durable disk
# and runs several instances, so it needs Firestore. SQLite is the default for
# local runs and a single VM, where AI_USAGE_DB_PATH is used instead.
USAGE_STORE=firestore
FIRESTORE_PROJECT=eon-backend-511813
FIRESTORE_DATABASE=(default)
AI_USAGE_DB_PATH=/var/lib/aikundli/ai_usage.db

# Owner dashboard (GET /v1/events/summary). Send it as the X-Analytics-Token
# header. Leave empty to keep the dashboard disabled.
ANALYTICS_TOKEN=

# Per-IP burst limits on the compute and AI endpoints (docs/api.md). Leave true
# unless a load test needs it off.
RATE_LIMIT_ENABLED=true

# Gemini Live voice, metered per turn (one question plus one answer) per install.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_FALLBACK_MODELS=gemini-3.1-flash-live-preview
LIVE_MAX_SECONDS=180
LIVE_FREE_DAILY_TURNS=4
LIVE_PLUS_DAILY_TURNS=40
LIVE_SESSION_TOKEN_TTL_SECONDS=90
LIVE_VOICE_NAME=Charon

# Google Play subscriptions. Requires a service account with the
# androidpublisher scope added to the Play Console app. Leave blank to keep
# billing disabled (the app then shows the paywall as unavailable).
GOOGLE_PLAY_PACKAGE_NAME=in.aikundli.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PLUS_PRODUCT_ID=ai_kundli_plus_monthly
# Hours between Google Play re-checks when /billing/entitlement is called.
PLUS_REFRESH_HOURS=12

# Geocoding. A key is optional; without it the API uses Nominatim/Photon.
GOOGLE_MAPS_API_KEY=
GEOCODING_PROVIDER=auto
GEOCODING_USER_AGENT=AIKundli/1.0 (support@yourdomain.example)
