ENVIRONMENT=development
EPHE_PATH=ephe
CORS_ORIGINS=*

# Google Places API (New). Leave empty to use Nominatim for local development.
GOOGLE_MAPS_API_KEY=
GEOCODING_PROVIDER=auto
GEOCODING_USER_AGENT=JyotishApp/0.1 (support@example.com)

# AI reading and chat. Leave the key empty to use the built-in chart-based answers.
# Confirm the exact model IDs in AI Studio before deploying; a wrong ID simply
# falls through to the next model and then to the chart-based reply.
GEMINI_API_KEY=
# Optional extra keys, comma separated. Tried in order per model when a key is
# rate limited (429 -> 60s cooldown). Keys in one Google Cloud project share the
# same free-tier quota, so this only raises throughput across separate projects.
# Do not use extra projects to exceed the free quota; that breaks Google's terms.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_ENABLE_SEARCH=true
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_FALLBACK_MODELS=gemini-3.1-flash-live-preview
AI_TIMEOUT_SECONDS=45
AI_CACHE_TTL_SECONDS=43200
AI_CACHE_MAX_ENTRIES=500

# Daily AI limits. Chat is counted per install; the global budget is a hard cost cap.
AI_FREE_DAILY_MESSAGES=5
AI_PLUS_DAILY_MESSAGES=50
AI_GLOBAL_DAILY_BUDGET=2000
AI_USAGE_DB_PATH=data/ai_usage.db

# Voice ("AI Panditji talk") is metered per turn, one question plus one answer.
# The app gets a short-lived token per turn; the API key never leaves the server.
LIVE_MAX_SECONDS=180
LIVE_FREE_DAILY_TURNS=4
LIVE_PLUS_DAILY_TURNS=40
LIVE_SESSION_TOKEN_TTL_SECONDS=90
LIVE_VOICE_NAME=Charon

# Google Play subscription. Leave the JSON empty to keep billing disabled locally.
GOOGLE_PLAY_PACKAGE_NAME=in.aikundli.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PLUS_PRODUCT_ID=ai_kundli_plus_monthly
PLUS_REFRESH_HOURS=12

# Phase 2: Firebase Admin SDK credential set (JSON contents or file path).
# FIREBASE_CREDENTIALS_JSON=
